  "rounds": [
    { "name": "캐릭터 시트 읽기", "minutes": 10, "pick": 0, "note": "'1. 캐릭터 시트'와 '2. 캐릭터 시트'를 조용히 읽어요." },
    { "name": "프롤로그와 근황 보고", "minutes": 10, "pick": 0, "note": "가즈미 역이 1번 시트의 프롤로그를 소리 내어 읽고, 가즈미부터 차례로 자기 캐릭터 표지의 근황을 읽어요." },
    { "name": "차 안의 대화", "minutes": 10, "pick": 0, "note": "'3. 저택으로 가는 차 안의 대화'를 열고 자기 캐릭터의 대사를 소리 내어 읽어요." },
    { "name": "저택에서의 행동", "minutes": 5, "pick": 0, "note": "'4. 저택에서의 행동'을 조용히 읽어요." },
    { "name": "시체 발견과 의견 교환", "minutes": 20, "pick": 0, "talk": true, "note": "'5. 시체 발견 때의 대화'에서 자기 대사를 읽은 뒤 자유롭게 정보를 나눠요. 밀담할 수 있어요." },
    { "name": "저택 수색", "minutes": 5, "pick": 1, "note": "수색 장소 시트를 선착순으로 1장씩 가져가 조용히 읽어요. 다른 사람에게 보여주면 안 돼요." },
    { "name": "마지막 의견 교환", "minutes": 25, "pick": 0, "talk": true, "note": "목적을 이루기 위해 자유롭게 정보를 나눠요. 밀담할 수 있어요." },
    { "name": "밀담 금지 5분", "minutes": 5, "pick": 0, "note": "마지막 5분은 밀담 없이 모두 함께 이야기해요." },
    { "name": "추리 발표", "minutesByVariant": { "5": 5, "6": 6, "7": 7 }, "minutes": 7, "pick": 0, "note": "아무 순서로 한 명씩 1분 동안 추리를 발표해요." }
  ],
