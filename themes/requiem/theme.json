  "characterInfo": {
    "kazumi": { "name": "가즈미", "sub": "一海 · 장녀 · 30세", "note": "수족관 트레이너. 운동 신경을 살려 돌고래를 훈련해요.", "img": "img/kazumi.jpg" },
    "seiji": { "name": "세이지", "sub": "晴二 · 장남 · 29세", "note": "구조대원. 인명이 최우선, 매일 근력 운동을 해요.", "img": "img/seiji.jpg" },
    "renzo": { "name": "렌조", "sub": "蓮三 · 차남 · 28세", "note": "사진가. 여전히 사람 사귀는 게 서툴러요.", "img": "img/renzo.jpg" },
    "yotsuba": { "name": "요쓰바", "sub": "四葉 · 차녀 · 27세", "note": "교토 절임 가게 점원이자 잡지 독자 모델.", "img": "img/yotsuba.jpg" },
    "keigo": { "name": "게이고", "sub": "渓五 · 삼남 · 26세", "note": "밴드맨. 자기 음악을 계속하고 있어요.", "img": "img/keigo.jpg" },
    "ayumu": { "name": "아유무", "sub": "歩六 · 사남 · 25세", "note": "호텔 프로듀서. 일단은 사장이에요.", "img": "img/ayumu.jpg" },
    "anna": { "name": "안나", "sub": "杏七 · 삼녀 · 24세", "note": "바리스타. 동네 대회 6위, 인정한 커피만 마셔요.", "img": "img/anna.jpg" }
  },
